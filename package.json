{
  "name": "switch-ext-github-prs",
  "version": "0.1.0",
  "private": true,
  "description": "The user's GitHub pull requests as a Switch extension: each one's state and checks, within seconds.",
  "license": "MIT",
  "repository": "github:zachsents/switch-ext-github-prs",
  "extension": {
    "name": "github-prs",
    "command": [
      "python3",
      "./main.py"
    ],
    "shim": "switchboard",
    "needs": [
      "always-on"
    ],
    "heartbeat": 300000
  }
}
